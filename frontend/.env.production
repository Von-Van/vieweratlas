# URL where the pipeline-exported frontend data JSON is served.
# In production, CloudFront serves this from the S3 data lake bucket.
VITE_DATA_URL=/data/frontend-data.json

# Absolute origin the site is served from, e.g. https://example.com
# Set this once a custom domain exists: it adds the canonical and og:url tags.
# Left empty, those tags are omitted rather than emitted with a wrong value.
VITE_SITE_URL=
