{
  "comment": "Reference policy shapes. deploy.sh and create-schedules.sh are the idempotent sources of truth.",
  "roles": {
    "collector_task_role": {
      "name": "vieweratlas-collector-task-role",
      "trusted_service": "ecs-tasks.amazonaws.com",
      "permissions": {
        "s3": {
          "actions": ["s3:GetBucketLocation", "s3:GetObject", "s3:PutObject", "s3:ListBucket"],
          "object_scope": "arn:aws:s3:::${S3_BUCKET}/${S3_PREFIX}raw/snapshots/v2/*",
          "list_scope": "${S3_PREFIX}raw/snapshots/v2/*"
        },
        "twitch_credentials": {
          "actions": ["secretsmanager:GetSecretValue", "secretsmanager:PutSecretValue"],
          "resource": "arn:aws:secretsmanager:${AWS_REGION}:${AWS_ACCOUNT_ID}:secret:${TWITCH_CREDENTIALS_SECRET_ID}*"
        },
        "survey_lease": {
          "actions": ["dynamodb:GetItem", "dynamodb:PutItem", "dynamodb:UpdateItem", "dynamodb:DeleteItem"],
          "resource": "arn:aws:dynamodb:${AWS_REGION}:${AWS_ACCOUNT_ID}:table/${DYNAMODB_STATE_TABLE}"
        }
      }
    },
    "collector_execution_role": {
      "name": "vieweratlas-collector-execution-role",
      "trusted_service": "ecs-tasks.amazonaws.com",
      "managed_policy": "arn:aws:iam::aws:policy/service-role/AmazonECSTaskExecutionRolePolicy"
    },
    "analysis_task_role": {
      "name": "vieweratlas-analysis-task-role",
      "trusted_service": "ecs-tasks.amazonaws.com",
      "permissions": {
        "s3": {
          "actions": ["s3:GetBucketLocation", "s3:GetObject", "s3:PutObject", "s3:ListBucket"],
          "scope": "${S3_BUCKET}/${S3_PREFIX}"
        }
      }
    },
    "analysis_execution_role": {
      "name": "vieweratlas-analysis-execution-role",
      "trusted_service": "ecs-tasks.amazonaws.com",
      "managed_policy": "arn:aws:iam::aws:policy/service-role/AmazonECSTaskExecutionRolePolicy"
    },
    "scheduler_role": {
      "name": "vieweratlas-scheduler-ecs-role",
      "trusted_service": "scheduler.amazonaws.com",
      "permissions": ["ecs:RunTask", "iam:PassRole"]
    }
  },
  "disabled_paths": ["vod", "discovery", "worker"]
}
