{
  "family": "vieweratlas-collector",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "ephemeralStorage": {
    "sizeInGiB": 21
  },
  "containerDefinitions": [
    {
      "name": "collector",
      "image": "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/vieweratlas-collector:${IMAGE_TAG}",
      "essential": true,
      "command": ["python", "-u", "main.py", "survey", "config.yaml"],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/vieweratlas-collector",
          "awslogs-region": "${AWS_REGION}",
          "awslogs-stream-prefix": "collector"
        }
      },
      "environment": [
        {
          "name": "STORAGE_TYPE",
          "value": "s3"
        },
        {
          "name": "S3_BUCKET",
          "value": "${S3_BUCKET}"
        },
        {
          "name": "S3_PREFIX",
          "value": "${S3_PREFIX}"
        },
        {
          "name": "S3_REGION",
          "value": "${AWS_REGION}"
        },
        {
          "name": "LOG_LEVEL",
          "value": "INFO"
        },
        {
          "name": "DYNAMODB_STATE_TABLE",
          "value": "${DYNAMODB_STATE_TABLE}"
        },
        {
          "name": "TWITCH_CREDENTIALS_SECRET_ID",
          "value": "${TWITCH_CREDENTIALS_SECRET_ID}"
        }
      ],
      "stopTimeout": 120
    }
  ],
  "taskRoleArn": "arn:aws:iam::${AWS_ACCOUNT_ID}:role/vieweratlas-collector-task-role",
  "executionRoleArn": "arn:aws:iam::${AWS_ACCOUNT_ID}:role/vieweratlas-collector-execution-role"
}
