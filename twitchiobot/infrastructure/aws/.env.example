# ============================================================
# ViewerAtlas — AWS Deployment Environment Variables
# ============================================================
# Copy this file to .env and fill in the values before deploying.
#   cp .env.example .env
#
# These variables are consumed by the AWS deployment, authorization, schedule,
# monitoring, smoke-test, and controlled-rollout helpers in this folder.
# ============================================================

# ── AWS Account & Region ────────────────────────────────────
AWS_REGION=us-east-1
# Keep the AWS CLI from opening its interactive pager during this guide.
AWS_PAGER=
# AWS_ACCOUNT_ID is auto-detected from `aws sts get-caller-identity`

# ── S3 Data Lake ────────────────────────────────────────────
# REQUIRED.  Unique bucket name for all ViewerAtlas data.
S3_BUCKET=vieweratlas-data-lake
S3_PREFIX=vieweratlas/

# ── ECS ─────────────────────────────────────────────────────
ECS_CLUSTER=vieweratlas-cluster
# These example subnets are public and use an Internet Gateway, so scheduled
# Fargate tasks need a public IP for outbound Twitch/AWS HTTPS connections.
ASSIGN_PUBLIC_IP=ENABLED

# ── Twitch Credentials ─────────────────────────────────────
# ECS reads and rotates one JSON secret at runtime. Never paste its value here.
TWITCH_CREDENTIALS_SECRET_ID=vieweratlas/twitch/credentials

# ── Storage Backend ─────────────────────────────────────────
# 'file' for local development, 's3' for AWS deployment.
STORAGE_TYPE=file
# S3_REGION is the same as AWS_REGION by default.

# ── Custom Domain (optional) ────────────────────────────────
# Leave empty to serve on the generated *.cloudfront.net name.
# Setting DOMAIN_NAME makes cloudfront-setup.sh attach both the apex and the
# www name to the distribution.
# DOMAIN_NAME=example.com
# Certificate covering both names. MUST be in us-east-1: CloudFront accepts
# certificates from that region only, regardless of AWS_REGION above.
# ACM_CERT_ARN=arn:aws:acm:us-east-1:123456789012:certificate/abc-123

# ── Site Analytics ──────────────────────────────────────────
# CloudFront distribution whose access logs feed enable-access-logs.sh.
# DISTRIBUTION_ID=E123ABC456DEF

# ── Alerts ──────────────────────────────────────────────────
# Email address for AWS Budget and SNS alarm notifications.
ALERT_EMAIL=
# Required by safe-deploy.sh; increase only after the owner approves it.
BUDGET_LIMIT=50
# SNS topic name used by apply-monitoring.sh to construct the ARN.
SNS_TOPIC_NAME=vieweratlas-alerts

# ── Networking (ECS tasks) ──────────────────────────────────
# Replace with your VPC subnet and security group IDs.
# Required for EventBridge → ECS scheduled tasks.
SUBNET_IDS=
SECURITY_GROUP_ID=

# ── Deployment Behavior ─────────────────────────────────────
# Target environment: 'prod' (default) or 'staging'.
# Staging uses vieweratlas-staging-* names; prod uses vieweratlas-* names.
# ENVIRONMENT=prod
# IMAGE_TAG defaults to current git short SHA.
# IMAGE_TAG=
# Keep immutable tags authoritative. Set true only if you intentionally need latest.
# PUSH_LATEST=false

# ── EventBridge Schedules ───────────────────────────────────
# These defaults follow Eastern daylight-saving time automatically.
# SURVEY_SCHEDULE=cron(0 6,14,22 * * ? *)
# ANALYSIS_SCHEDULE=cron(0 1 * * ? *)
# SCHEDULE_TIMEZONE=America/New_York
# Set either state to DISABLED and rerun create-schedules.sh to pause it.
# SURVEY_SCHEDULE_STATE=ENABLED
# ANALYSIS_SCHEDULE_STATE=ENABLED

# ── Smoke Test / Monitoring ─────────────────────────────────
# S3_FRESHNESS_MAX_AGE_MINUTES=180
# Analysis-completion monitoring uses five rolling six-hour periods (30 hours).
# ANALYSIS_COMPLETION_ALARM_PERIOD_SECONDS=21600
# ANALYSIS_COMPLETION_EVALUATION_PERIODS=5
# SNS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:vieweratlas-alerts
