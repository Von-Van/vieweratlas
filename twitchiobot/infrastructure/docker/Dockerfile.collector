# ViewerAtlas Collector - Docker Image
FROM python:3.11-slim

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd -r app && useradd -r -g app -d /app app

# Copy requirements first (for better caching)
COPY src/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy application code
COPY src/*.py ./
COPY config/config.yaml ./config.yaml

# Create logs directory
RUN mkdir -p /app/logs && chown -R app:app /app

# Set environment variables
ENV PYTHONUNBUFFERED=1
ENV LOGS_DIR=/app/logs

USER app

# The collector is an EventBridge-launched, one-shot survey task. Its manifest is
# the durable health signal, so a long-running container health check is not used.
CMD ["python", "-u", "main.py", "survey", "config.yaml"]
