# Copy to twitchiobot/.env for local runs; main.py loads it with python-dotenv.
# Analysis of existing survey files needs none of the Twitch values below.

# Local-only Twitch EventSub credentials, needed only for `main.py survey`.
# Production sets TWITCH_CREDENTIALS_SECRET_ID (via infrastructure/aws/.env and
# the ECS task definition) instead, and then these five are never read.
TWITCH_CLIENT_ID=your_client_id_here
TWITCH_CLIENT_SECRET=your_client_secret_here
TWITCH_BOT_USER_ID=your_numeric_bot_user_id
TWITCH_OAUTH_TOKEN=your_raw_access_token_without_oauth_prefix
TWITCH_REFRESH_TOKEN=your_raw_refresh_token

# Storage Configuration
# Options: 'file' (local) or 's3' (AWS)
STORAGE_TYPE=file
# Root directory for file storage, relative to where main.py runs.
# Surveys are written under $LOGS_DIR/raw/snapshots/v2/, analysis output under
# $LOGS_DIR/data/ and $LOGS_DIR/processed/.
LOGS_DIR=logs

# AWS S3 Configuration (only needed if STORAGE_TYPE=s3)
S3_BUCKET=vieweratlas-data-lake
S3_PREFIX=vieweratlas/
S3_REGION=us-east-1

# AWS Credentials (only needed if STORAGE_TYPE=s3)
# Option 1: IAM role (recommended for ECS/EC2) - leave these empty
# Option 2: Access keys (for local testing)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Logging. Applies to YAML configs only; the named presets set their own level.
LOG_LEVEL=INFO
